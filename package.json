{
  "name": "matchday-nine-a-side",
  "version": "2.0.0",
  "description": "Organise 9-a-side football games: onboarding, polling, balanced teams and peer ratings.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "vite": "^8"
  },
  "scripts": {
    "dev": "npm run db:migrate:local && astro dev",
    "build": "astro build",
    "preview": "astro build && npm run db:migrate:local && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "test": "node --test test/*.test.js",
    "astro": "astro",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.0",
    "@astrojs/react": "^6.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "astro": "^7.0.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "wrangler": "^4.125.0"
  },
  "license": "MIT"
}
